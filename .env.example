# ============ Pingoo 配置 ============
# 复制成 .env 再修改：cp .env.example .env
# 这里只放程序启动前就要用到、或者保护数据库本身的配置。
# 站点地址、默认时区、发信（SMTP）、AI 模型、积分规则等都在「管理后台」里设置，改了马上生效，不用重启。

# ---------- 服务 ----------
SERVER_PORT=5004
# 也可以直接写完整监听地址，会覆盖 SERVER_PORT
# LISTEN_ADDR=127.0.0.1:5004
# 前面有反向代理（Nginx、Caddy、Cloudflare Tunnel 等）时，填代理的 IP 或网段，逗号分隔，例如 127.0.0.1,172.16.0.0/12。
# 只有请求来自这些地址时才会读 X-Forwarded-For 里的访客 IP（用于登录限速、发信限额和“已登录的设备”）；
# 不填就只认直接连上来的地址——没有代理时不要填，否则访客可以伪造自己的 IP。
TRUSTED_PROXIES=172.16.0.0/12
# 最前面是 Cloudflare 这类 CDN 时，可以让程序直接读 CDN 写入的访客真实 IP，不用把中间每一层代理都列进 TRUSTED_PROXIES：
# 这里填请求头的名字（Cloudflare 是 CF-Connecting-IP），TRUSTED_PROXIES 只填紧挨着 Pingoo 的那一层代理。
# 注意：源站要只接受来自 CDN 的流量，否则绕过 CDN 直连的人可以伪造这个头。
REAL_IP_HEADER=CF-Connecting-IP

# ---------- 管理员与安全（必填） ----------
# 站长（管理员）账号：第一次启动时（还没有管理员）用这个邮箱和密码建管理员。
# 之后在网页里改密码、改邮箱即可，这两项只在第一次生效。
ADMIN_EMAIL=
ADMIN_PASSWORD=change-me
# 用来加密服务账号密钥、AI 的 API Key、SMTP 密码和签名，至少 32 个字符。生成：openssl rand -hex 32
# 注意：改了它，已经保存的密钥就解不开了（需要重新填写），所有人也要重新登录。
APP_SECRET=

# ---------- PostgreSQL ----------
# 写完整连接串，或者分开写下面几项（二选一）
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/pingoo?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pingoo
DB_SSLMODE=disable

# ---------- 本地开发 ----------
# 设为 true 时不真的发信，邮件内容写进日志（正式环境不要打开，正文里有初始密码）
# MAIL_DRYRUN=true
